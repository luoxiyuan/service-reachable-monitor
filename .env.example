# ---------------------------------------------------------------------------
# service-reachable-monitor secrets.
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Any YAML value may reference these with ${VAR_NAME} interpolation.
# ---------------------------------------------------------------------------

# --- Chat robot webhooks (leave empty to disable that channel) --------------
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=REPLACE_ME
DINGTALK_SECRET=

WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=REPLACE_ME

FEISHU_WEBHOOK=https://open.example-im.com/open-apis/bot/v2/hook/REPLACE_ME

# Generic webhook: receives a JSON POST {"text": "...", "results": [...]}
CUSTOM_WEBHOOK_URL=

# --- Internal alarm-center (phone / SMS style callout), optional ------------
ALARM_CENTER_URL=
ALARM_CENTER_FALLBACK_NUMBER=13800138000

# --- Optional MySQL metadata store (owner lookup / interface inventory) -----
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- Reporting -------------------------------------------------------------
MONITOR_LOG_FILE=logs/monitor.log
MONITOR_LOG_LEVEL=INFO